# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Postgres (required; consumed by both the app and compose) ---
POSTGRES_USER=asr
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=asr_pipeline
# Host as seen by the app. 'localhost' when running uvicorn on the host,
# 'postgres' when running inside compose (set for you in compose.yaml).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Models ---
# tiny.en / base.en / small.en / medium / large-v3, larger is more accurate
# and much slower on CPU.
WHISPER_MODEL=small.en
# Must output 384 dimensions to match the chunks.embedding column.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Summarization (optional) ---
# Get one at console.groq.com. Without it /transcribe and /search work
# normally and /summarize returns 503.
GROQ_API_KEY=
# Groq retires models without warning: llama-3.3-70b-versatile was the
# default here until it began answering 404. Check what is servable with
# `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $KEY"`.
SUMMARIZE_MODEL=openai/gpt-oss-120b

# --- Demo (the Streamlit service in compose) ---
# The API key the demo calls with, created by
# `uv run python scripts/create_api_key.py demo 15`. Empty here on purpose:
# with no key the demo starts and says so instead of failing. It stays
# server-side, Streamlit renders on the server, so the browser never sees it.
DEMO_API_KEY=
# Transcript ids for the Summarize tab. compose defaults these to the rows in
# data/seed/nasa_corpus.sql, so set them only for a different corpus.
# DEMO_TRANSCRIPT_GATEWAY=
# DEMO_TRANSCRIPT_MICROBIOLOGY=
# DEMO_TRANSCRIPT_APOLLO=

# --- Storage ---
# Where uploads are buffered between the API and the worker. Both processes
# must be able to read this path.
TEMP_AUDIO_DIR=/tmp/asr-pipeline

# --- Upload limits ---
# Both accept 0 to disable the check, and both are deliberately loose here:
# a public deployment should set them low. The quota in audio minutes is
# applied only after ffprobe has read the file, so MAX_UPLOAD_MB is the one
# limit that can act while the bytes are still arriving.
MAX_UPLOAD_MB=500
# Longest single recording accepted, in seconds. 0 = no limit, which is what
# you want locally; on a public demo a visitor waits through the whole
# transcription, so keep it to a minute or two.
MAX_AUDIO_SECONDS=0

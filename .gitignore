# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local audio samples: never commit media
data/samples/*
!data/samples/.gitkeep
*.wav
*.mp3
*.m4a
*.flac
*.mp4

# Secrets
.env
.scratch/

# Local agent instructions
# Agent state, not project state: settings.local.json plus any git worktrees
# checked out under it. Untracked rather than ignored, a stray `git add -A`
# publishes both, and a worktree in here is a second copy of the whole repo,
# which is worse than noise: an edit can land in it instead of the real tree.
.claude/

# Personal planning docs
*.pdf
